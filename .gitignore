# Unity .gitignore
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
Recordings/

# IDE & Editor caches
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.opendb
*.VC.db

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Unity crash reports
sysinfo.txt
crash*

# Local logs
*.log
!ux_simulation.log

# Ensure Campaign~ and Specs~ special Unity folders are tracked
!Campaign~/
!Campaign~/**
!Specs~/
!Specs~/**
